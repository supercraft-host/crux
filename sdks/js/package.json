{
  "name": "crux-sdk",
  "version": "0.2.0",
  "description": "Supercraft Crux Game Services Backend SDK - player auth, cloud-save documents, leaderboards, economy, matchmaking, server registry, and config delivery.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "smoke": "tsx --env-file=smoke/.env.local smoke/run.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "game-backend",
    "backend-as-a-service",
    "crux",
    "crux",
    "supercraft",
    "leaderboard",
    "cloud-save",
    "player-authentication",
    "matchmaking",
    "economy",
    "server-browser"
  ],
  "homepage": "https://crux.supercraft.host",
  "bugs": "https://crux.supercraft.host",
  "license": "MIT"
}
