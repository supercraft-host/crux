# Copy to smoke/.env.local and fill in real values, then:
#   npm run smoke
#
# The API key is low-privilege (project-scoped, same thing any game client
# would ship with) so it's OK to reuse one across dev machines - just don't
# commit smoke/.env.local itself.

CRUX_BASE_URL=https://crux.supercraft.host
CRUX_PROJECT_ID=
CRUX_ENV_ID=
CRUX_API_KEY=
